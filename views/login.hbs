<div style="width: 100%; display:flex; justify-content:center;margin-top:2rem;">

  <form action="/handleLogin" method="POST" class="login-form">
    <h3 style="margin-bottom: 1rem;">Login</h3>
    <label for="">login</label>
    <input type="text" name="login" required="true" />
    <label for="">password</label>
    <input type="password" name="password" required="true" />
    <div class="flex">
      <button class="bt">login</button>
      <a class="bt" href="/register">register</a>
    </div>
  </form>
</div>