<div style="width: 100%; display:flex; justify-content:center;margin-top:2rem;">

  <form action="/handleRegister" method="POST" class="login-form">
    <h3 style="margin-bottom: 1rem;">Register</h3>
    <label for="">login</label>
    <input type="text" name="login" required="true" />
